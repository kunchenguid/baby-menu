        .catch((error) => {
        lastRefreshFailureAt = Date.now();
        throw error;
    })
        .finally(() => {
        refreshInFlight = undefined;
    });
    return refreshInFlight;
}
function slugifyProduct(product) {
    return product.toLowerCase().replace(/[^a-z0-9]/g, "");
}
function numericValue(value) {
    if (typeof value === "number" && Number.isFinite(value))
        return value;
    return undefined;
}
function nestedNumericValue(value) {
    if (!value || typeof value !== "object" || Array.isArray(value))
        return undefined;
    return numericValue(value.val);
}
function validIso(value) {
    if (typeof value !== "string")
        return undefined;
    return Number.isNaN(Date.parse(value)) ? undefined : value;
}
function normalizeBilling(raw) {
    if (!raw || typeof raw !== "object" || Array.isArray(raw))
        return undefined;
    const config = raw.config;
    if (!config || typeof config !== "object" || Array.isArray(config))
        return undefined;
    const currentPeriodReset = validIso(config.currentPeriod?.end);
    const billingPeriodReset = validIso(config.billingPeriodEnd);
    const resetAt = currentPeriodReset ?? billingPeriodReset;
    const resetField = currentPeriodReset
        ? "config.currentPeriod.end"
        : billingPeriodReset
            ? "config.billingPeriodEnd"
            : undefined;
    const windows = [];
    const creditPercent = numericValue(config.creditUsagePercent);
    if (creditPercent !== undefined) {
        const used = clampPercent(creditPercent);
        windows.push({
            id: "credits",
            label: "credits",
            kind: "credits",
            percentUsed: used,
            percentRemaining: 100 - used,
            resetAt,
            provenance: {
                percentageField: "config.creditUsagePercent",
                resetField,
            },
        });
    }
    const productUsage = Array.isArray(config.productUsage) ? config.productUsage : [];
    productUsage.forEach((entry, index) => {
        if (!entry || typeof entry !== "object" || Array.isArray(entry))
            return;
        const product = entry.product;
        const usagePercent = numericValue(entry.usagePercent);
        if (typeof product !== "string" || !product || usagePercent === undefined)
            return;
        const productId = slugifyProduct(product);
        if (!productId)
            return;
        const used = clampPercent(usagePercent);
        windows.push({
            id: `product:${productId}`,
            label: product,
            kind: "credits",
            percentUsed: used,
            percentRemaining: 100 - used,
            resetAt,
            provenance: {
                percentageField: `config.productUsage[${index}].usagePercent`,
                resetField,
            },
        });
    });
    if (windows.length === 0)
        return undefined;
    const prepaidBalance = nestedNumericValue(config.prepaidBalance);
    const plan = typeof config.subscription_tier === "string" ? config.subscription_tier : undefined;
    return {
        schemaVersion: CURRENT_CACHE_SCHEMA_VERSION,
        source: "api",
        plan,
        windows,
        credits: prepaidBalance === undefined
            ? undefined
            : { remaining: prepaidBalance, unit: "credits", sourceField: "config.prepaidBalance.val" },
        refreshedAt: new Date().toISOString(),
        stale: false,
    };
}
async function fetchBilling(key) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), API_TIMEOUT_MS);
    try {
        const headers = { Authorization: `Bearer ${key}`, Accept: "application/json", "x-grok-client-mode": "billing" };
        const clientVersion = readClientVersion();
        if (clientVersion)
            headers["x-grok-client-version"] = clientVersion;
        let response;
        try {
            response = await fetch(BILLING_URL, { headers, signal: controller.signal });
        }
        catch (error) {
            const timedOut = error instanceof Error && error.name === "AbortError";
            throw new QuotaFailure("connectivity", timedOut ? "Grok billing request timed out" : "Grok billing is unreachable", timedOut ? "timeout" : undefined);
        }
        if (response.status === 401 || response.status === 403)
            throw new QuotaFailure("credential_rejected", "Grok credentials were rejected", `http:${response.status}`);
        if (response.status === 429)
            throw new QuotaFailure("rate_limited", "Grok billing is rate-limited", "http:429");
        if (response.status >= 500)
            throw new QuotaFailure("quota_service", "Grok billing is temporarily unavailable", `http:${response.status}`);
        if (!response.ok)
            throw new QuotaFailure("quota_service", "Grok billing is unavailable", `http:${response.status}`);
        let raw;
        try {
            raw = await response.json();
        }
        catch {
            throw new QuotaFailure("parse_incompatible", "Grok billing response could not be parsed");
        }
        const snapshot = normalizeBilling(raw);
        if (!snapshot) {
            const config = raw && typeof raw === "object" && !Array.isArray(raw) ? raw.config : undefined;
            const hasKnownPeriod = config && typeof config === "object" && !Array.isArray(config) &&
                (typeof config.billingPeriodEnd === "string" ||
                    (config.currentPeriod && typeof config.currentPeriod === "object" && typeof config.currentPeriod.end === "string"));
            if (hasKnownPeriod)
                throw new QuotaFailure("quota_unreported", "Official Grok billing did not report a quota percentage");
            throw new QuotaFailure("parse_incompatible", "Grok billing response did not contain a supported quota window");
        }
        return snapshot;
    }
    finally {
