        return value === "config.creditUsagePercent";
    return /^config\.productUsage\[(0|[1-9]\d*)\]\.usagePercent$/.test(value);
}
function isSupportedWindow(window) {
    if (!window || typeof window !== "object" || Array.isArray(window))
        return false;
    if (typeof window.id !== "string" ||
        (window.id !== "credits" && !/^product:[a-z0-9]+$/.test(window.id)) ||
        typeof window.label !== "string" ||
        !window.label ||
        (window.kind !== undefined && window.kind !== "credits") ||
        typeof window.percentUsed !== "number" ||
        !Number.isFinite(window.percentUsed) ||
        window.percentUsed < 0 ||
        window.percentUsed > 100 ||
        typeof window.percentRemaining !== "number" ||
        !Number.isFinite(window.percentRemaining) ||
        window.percentRemaining !== 100 - window.percentUsed ||
        !window.provenance ||
        typeof window.provenance !== "object" ||
        Array.isArray(window.provenance) ||
        typeof window.provenance.percentageField !== "string" ||
        !isPercentageFieldForWindow(window.id, window.provenance.percentageField)) {
        return false;
    }
    const resetField = window.provenance.resetField;
    if (window.resetAt === undefined)
        return resetField === undefined;
    return validIso(window.resetAt) !== undefined &&
        (resetField === "config.currentPeriod.end" || resetField === "config.billingPeriodEnd");
}
function isSupportedCredits(credits) {
    if (credits === undefined)
        return true;
    return credits &&
        typeof credits === "object" &&
        !Array.isArray(credits) &&
        typeof credits.remaining === "number" &&
        Number.isFinite(credits.remaining) &&
        credits.unit === "credits" &&
        credits.sourceField === "config.prepaidBalance.val";
}
function isTrustedSnapshot(snapshot) {
    return snapshot &&
        typeof snapshot === "object" &&
        !Array.isArray(snapshot) &&
        snapshot.schemaVersion === CURRENT_CACHE_SCHEMA_VERSION &&
        snapshot.source === "api" &&
        (snapshot.plan === undefined || typeof snapshot.plan === "string") &&
        Array.isArray(snapshot.windows) &&
        snapshot.windows.length > 0 &&
        snapshot.windows.every(isSupportedWindow) &&
        isSupportedCredits(snapshot.credits) &&
        validIso(snapshot.refreshedAt) !== undefined &&
        snapshot.stale === false;
}
function deleteCachedSnapshot(context) {
    context.db.run(`DELETE FROM ${CACHE_TABLE} WHERE key = ?`, [EXTENSION_ID]);
}
function readTrustedCachedSnapshot(context) {
    const row = context.db.get(`SELECT value FROM ${CACHE_TABLE} WHERE key = ?`, [EXTENSION_ID]);
    if (!row)
        return undefined;
    try {
        const snapshot = JSON.parse(row.value);
        if (!isTrustedSnapshot(snapshot)) {
            deleteCachedSnapshot(context);
            return undefined;
        }
        return snapshot;
    }
    catch {
        deleteCachedSnapshot(context);
        return undefined;
    }
}
function readCachedSnapshot(context, status) {
    const snapshot = readTrustedCachedSnapshot(context);
    return snapshot ? { ...snapshot, stale: true, status } : undefined;
}
function writeCachedSnapshot(context, snapshot) {
    if (!isTrustedSnapshot(snapshot))
        throw new QuotaFailure("parse_incompatible", "Grok billing response did not produce a trusted cache snapshot");
    context.db.run(`INSERT INTO ${CACHE_TABLE} (key, value, updated_at)
     VALUES (?, ?, ?)
