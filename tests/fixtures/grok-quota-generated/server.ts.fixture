import { spawn } from "node:child_process";
import { accessSync, constants, existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { delimiter, join } from "node:path";
const BILLING_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits";
const EXTENSION_ID = "grok-quota";
const CACHE_TABLE = "grok_quota_cache";
const CURRENT_CACHE_SCHEMA_VERSION = 1;
const API_TIMEOUT_MS = 15_000;
const CLI_TIMEOUT_MS = Number(process.env.GROK_QUOTA_TEST_CLI_TIMEOUT_MS) || 20_000;
const CLI_OUTPUT_LIMIT = 128 * 1024;
const REFRESH_FAILURE_COOLDOWN_MS = 10_000;
let quotaInFlight;
let refreshInFlight;
let lastRefreshFailureAt = 0;
class QuotaFailure extends Error {
