}
function staleStatus(kind) {
    return {
        auth_required: "auth-required",
        cli_not_found: "cli-not-found",
        cli_launch_failed: "refresh-failed",
        credential_rejected: "credentials-rejected",
        connectivity: "network-unavailable",
        rate_limited: "rate-limited",
        quota_service: "quota-service-unavailable",
        quota_unreported: "quota-unreported",
        parse_incompatible: "billing-response-changed",
    }[kind] ?? "refresh-failed";
}
async function getQuotaInternal(context) {
    const sourcesTried = ["local-auth"];
    let refreshAttempted = false;
    ensureCache(context);
    try {
        let candidates = collectAuthCandidates(readAuthData());
        const selectedSessionExpired = candidates.length > 0 && candidates[0].isSession && candidates[0].expired;
        if (candidates.length === 0 || selectedSessionExpired) {
            refreshAttempted = true;
            sourcesTried.push("grok-cli-refresh");
            await runOfficialRefresh();
            candidates = collectAuthCandidates(readAuthData());
        }
        const currentCandidates = candidates.filter((candidate) => !candidate.expired);
        if (currentCandidates.length === 0)
            throw new QuotaFailure("auth_source_incompatible", "Grok auth did not contain a current credential");
        sourcesTried.push("billing-api");
        let rejected = false;
        for (const candidate of currentCandidates) {
            try {
                const snapshot = await fetchBilling(candidate.key);
                writeCachedSnapshot(context, snapshot);
                return { ok: true, checkedAt: new Date().toISOString(), data: snapshot };
            }
            catch (error) {
                if (error instanceof QuotaFailure && error.kind === "credential_rejected") {
                    rejected = true;
                    continue;
                }
                throw error;
            }
        }
        if (rejected && !refreshAttempted) {
            refreshAttempted = true;
            sourcesTried.push("grok-cli-refresh");
            await runOfficialRefresh();
            const refreshedCandidates = collectAuthCandidates(readAuthData()).filter((candidate) => !candidate.expired);
            for (const candidate of refreshedCandidates) {
                try {
                    const snapshot = await fetchBilling(candidate.key);
                    writeCachedSnapshot(context, snapshot);
                    return { ok: true, checkedAt: new Date().toISOString(), data: snapshot };
                }
                catch (error) {
                    if (!(error instanceof QuotaFailure) || error.kind !== "credential_rejected")
                        throw error;
                }
            }
            throw new QuotaFailure("credential_rejected", "Grok refreshed credentials were rejected");
        }
        if (rejected)
            throw new QuotaFailure("credential_rejected", "Grok refreshed credentials were rejected");
        throw new QuotaFailure("auth_source_incompatible", "Grok auth did not contain a usable credential");
    }
    catch (error) {
        const failure = error instanceof QuotaFailure ? error : new QuotaFailure("quota_service", "Grok quota is unavailable");
        const checkedAt = new Date().toISOString();
        if (failure.kind === "quota_unreported") {
            readTrustedCachedSnapshot(context);
            return { ok: false, checkedAt, error: failure.message, sourceTried: sourcesTried, failure: { kind: failure.kind, message: failure.message, sourcesTried, diagnostic: failure.diagnostic } };
        }
        sourcesTried.push("cache");
        const cached = readCachedSnapshot(context, staleStatus(failure.kind));
        if (cached)
            return { ok: true, checkedAt, data: cached, warning: { kind: failure.kind, message: failure.message, sourcesTried, diagnostic: failure.diagnostic } };
        return { ok: false, checkedAt, error: failure.message, sourceTried: sourcesTried, failure: { kind: failure.kind, message: failure.message, sourcesTried, diagnostic: failure.diagnostic } };
    }
}
export const actions = {
    async getQuota(_input, context) {
        if (quotaInFlight)
            return quotaInFlight;
        quotaInFlight = getQuotaInternal(context).finally(() => {
            quotaInFlight = undefined;
        });
        return quotaInFlight;
    },
};
