        catch {
            return undefined;
        }
    }
    return readJsonFile(resolveAuthPath());
}
function parseExpiry(value) {
    if (typeof value !== "string" || !value)
        return undefined;
    const parsed = Date.parse(value);
    return Number.isNaN(parsed) ? undefined : parsed;
}
function collectAuthCandidates(raw) {
    if (!raw || typeof raw !== "object" || Array.isArray(raw))
        return [];
    const now = Date.now();
    const candidates = [];
    for (const value of Object.values(raw)) {
        if (!value || typeof value !== "object" || Array.isArray(value))
            continue;
        const entry = value;
        if (typeof entry.key !== "string" || !entry.key)
            continue;
        const expiresAtMs = parseExpiry(entry.expires_at);
        candidates.push({
            key: entry.key,
            isSession: (typeof entry.refresh_token === "string" && entry.refresh_token.length > 0) ||
                (typeof entry.auth_mode === "string" && entry.auth_mode.length > 0),
            expiresAtMs,
            expired: expiresAtMs !== undefined && expiresAtMs <= now,
        });
    }
    return candidates.sort((left, right) => {
        if (left.expired !== right.expired)
            return left.expired ? 1 : -1;
        if (left.isSession !== right.isSession)
            return left.isSession ? -1 : 1;
        return (right.expiresAtMs ?? 0) - (left.expiresAtMs ?? 0);
    });
}
function readClientVersion() {
    const raw = readJsonFile(join(resolveGrokHome(), "version.json"));
    if (!raw || typeof raw !== "object")
        return undefined;
    const version = raw.version;
    return typeof version === "string" && version ? version : undefined;
}
function isExecutable(file) {
    try {
        accessSync(file, constants.X_OK);
        return true;
    }
    catch {
        return false;
    }
}
function resolveGrokExecutable() {
    const candidates = [];
    if (process.env.GROK_CLI_PATH)
        candidates.push(process.env.GROK_CLI_PATH);
    if (process.env.GROK_HOME)
        candidates.push(join(process.env.GROK_HOME, "bin", "grok"));
    for (const directory of (process.env.PATH || "").split(delimiter)) {
        if (directory)
            candidates.push(join(directory, "grok"));
    }
    candidates.push(join(homedir(), ".local", "bin", "grok"));
    candidates.push(join(homedir(), ".grok", "bin", "grok"));
    candidates.push("/opt/homebrew/bin/grok", "/usr/local/bin/grok");
    for (const candidate of [...new Set(candidates)]) {
        if (isExecutable(candidate))
            return candidate;
    }
    return undefined;
}
function safeAuthMarker(text) {
    const normalized = text.toLowerCase();
    return normalized.includes("authentication required") ||
        normalized.includes("not authenticated") ||
        normalized.includes("sign in to grok") ||
        normalized.includes("run `grok login`");
}
function runOfficialRefresh() {
    if (refreshInFlight)
        return refreshInFlight;
    if (lastRefreshFailureAt && Date.now() - lastRefreshFailureAt < REFRESH_FAILURE_COOLDOWN_MS) {
        return Promise.reject(new QuotaFailure("cli_launch_failed", "Grok session refresh is cooling down"));
    }
    refreshInFlight = (async () => {
        const executable = resolveGrokExecutable();
        if (!executable)
            throw new QuotaFailure("cli_not_found", "Grok CLI was not found");
        await new Promise((resolve, reject) => {
            const child = spawn(executable, ["models"], {
                env: { ...process.env, NO_COLOR: "1", TERM: "dumb" },
                shell: false,
                stdio: ["ignore", "pipe", "pipe"],
            });
            let stdout = Buffer.alloc(0);
            let stderr = Buffer.alloc(0);
            let settled = false;
            let timeoutFailure;
            let forceKillTimer;
            const appendBounded = (current, chunk) => Buffer.concat([current, chunk]).subarray(0, CLI_OUTPUT_LIMIT);
            child.stdout?.on("data", (chunk) => {
                stdout = appendBounded(stdout, Buffer.from(chunk));
            });
            child.stderr?.on("data", (chunk) => {
                stderr = appendBounded(stderr, Buffer.from(chunk));
            });
            const finish = (failure) => {
                if (settled)
                    return;
                settled = true;
                clearTimeout(timer);
                if (forceKillTimer)
                    clearTimeout(forceKillTimer);
                if (failure)
                    reject(failure);
                else
                    resolve();
            };
            const timer = setTimeout(() => {
                timeoutFailure = new QuotaFailure("cli_launch_failed", "Grok CLI refresh timed out", "timeout");
                child.kill("SIGTERM");
                forceKillTimer = setTimeout(() => child.kill("SIGKILL"), 1_000);
            }, CLI_TIMEOUT_MS);
            child.once("error", (error) => {
                const code = typeof error.code === "string" ? error.code : "launch";
                finish(new QuotaFailure("cli_launch_failed", "Grok CLI could not be launched", `code:${code}`));
            });
            child.once("close", (code) => {
                if (timeoutFailure) {
                    finish(timeoutFailure);
                    return;
                }
                if (code === 0) {
                    finish();
                    return;
                }
                const output = `${stdout.toString("utf8")}\n${stderr.toString("utf8")}`;
                const kind = safeAuthMarker(output) ? "auth_required" : "cli_launch_failed";
                const message = kind === "auth_required" ? "Grok sign-in is required" : "Grok CLI could not refresh the session";
                finish(new QuotaFailure(kind, message, `exit:${typeof code === "number" ? code : "signal"}`));
            });
        });
